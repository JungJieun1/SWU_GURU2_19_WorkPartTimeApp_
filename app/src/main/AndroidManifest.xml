        <activity android:name=".signup.SignUpCompleteActivity" android:exported="false" />

        <!-- 메인 화면 (사장님/알바생) -->
        <activity android:name=".Boss.BossMainActivity" android:exported="false" />
        <activity android:name=".StaffMainActivity" android:exported="false" />

        <!-- 사장님 세부 기능들 -->
        <!-- Boss 폴더 안에 있어서 경로 ".Boss.WorkerListActivity" 로 적어야 함 -->
        <activity android:name=".Boss.WorkerListActivity" android:exported="false" />
        <activity android:name=".Boss.TaskListActivity" android:exported="false" />
        <activity android:name=".NoticeListActivity" android:exported="false" />
        <activity android:name=".NoticeDetailActivity" android:exported="false" />
        <activity android:name=".NoticeWriteActivity" android:exported="false" />

        <!-- 더보기/마이 (로그아웃, 회원탈퇴) -->
        <activity android:name=".MoreActivity" android:exported="false" />

