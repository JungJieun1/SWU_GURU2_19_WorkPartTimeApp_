        <activity
            android:name=".activity_employee_add"
            android:exported="false" />
        <activity
            android:name=".activity_employee_list"
            android:exported="false" />
        <activity
            android:name=".activity_workplace_add"
            android:exported="false" />
        <activity
            android:name=".activity_workplace_list"
            android:exported="false" />
        <activity
            android:name=".MainActivity" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 회원가입 화면들 -->
        <activity android:name=".signup.SignUpActivity_1" android:exported="false" />
